<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # If the project root is accidentally exposed, deny Laravel source and secrets.
    RewriteRule ^(\.env|\.git|app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L,NC]
    RewriteRule \.(env|log|sql|bak|backup|old|orig|save|swp|ini|sh|pem|key|crt|yml|yaml|toml|map)$ - [F,L,NC]

    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
